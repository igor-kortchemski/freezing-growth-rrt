FreezingGrowth.RRT.uniformVertexDepthLaw_deviation_tendsto_zero {ε : ℝ} (hε : 0 < ε) :
  Filter.Tendsto (fun n => (FreezingGrowth.RRT.uniformVertexDepthLaw n).real {k | ε ≤ |↑k / Real.log ↑n - 1|})
    Filter.atTop (nhds 0)
FreezingGrowth.Word.exists_surviving_bernoulli_representation (xs : FreezingGrowth.Word) (ha : xs.admissible) :
  ∃ k ≤ List.length xs,
    ∃ (hk : FreezingGrowth.PositiveThrough xs.toSigns k),
      FreezingGrowth.plusCount xs.toSigns k = xs.attachments ∧
        FreezingGrowth.Forward.heightLaw xs.toSigns k = xs.heightLaw ∧
          ProbabilityTheory.HasLaw (fun ω => ∑ i with xs.toSigns (↑i + 1) = true, ω i)
            (FreezingGrowth.Forward.uniformActiveHeightLaw xs.toSigns k)
            (FreezingGrowth.bernoulliProductLaw (FreezingGrowth.populationBernoulliParameter xs.toSigns k hk))
FreezingGrowth.Word.binomial_tail_lower_bound (xs : FreezingGrowth.Word) (ha : xs.admissible) (r : ℝ) (hr : 1 ≤ r)
  (hcap : ∀ i < List.length xs, xs.toSigns (i + 1) = true → ↑(FreezingGrowth.activeCount xs.toSigns (i + 1)) ≤ r)
  (h : ℕ) :
  (ProbabilityTheory.binomial xs.attachments (FreezingGrowth.Word.reciprocalParameter r hr)).real {k | h ≤ k} ≤
    xs.heightLaw.real {k | h ≤ k}
FreezingGrowth.Word.high_population_domination_of_firstPairDeletion (hdelete : FreezingGrowth.FirstPairDeletionClaim)
  (xs : FreezingGrowth.Word) (ha : xs.admissible) {r : ℕ}
  (hhigh : ∃ j ≤ List.length xs, ↑r ≤ FreezingGrowth.activeCount xs.toSigns j) :
  FreezingGrowth.Word.HeightLE (List.replicate (r - 1) true) xs
FreezingGrowth.Scaling.height_scaling_limit_vertices_positive_horizons {x : ℕ → ℕ → ℤ} {α : ℝ} {f : ℝ → ℝ}
  (hx : ∀ (n : ℕ), 0 < n → FreezingGrowth.Scaling.IsSigned (x n) ∧ FreezingGrowth.Scaling.SurvivesThrough (x n) n)
  (hα0 : 0 < α) (hα1 : α < 1) (hf : ∀ᵐ (t : ℝ) ∂FreezingGrowth.Scaling.profileMeasure, 0 < f t)
  (hL1 : FreezingGrowth.Scaling.HasL1ReciprocalProfile x α fun t => 1 / f t) {p : ℝ} (hp : 1 ≤ p) :
  Filter.Tendsto
    (fun n =>
      MeasureTheory.eLpNorm
        (fun s =>
          ↑(FreezingGrowth.Forward.treeHeight s) / ↑s.vertices.card ^ (1 - α) -
            2 ^ (1 - α) * ∫ (t : ℝ) in Set.Icc 0 1, 1 / (2 * f t))
        (ENNReal.ofReal p) (FreezingGrowth.Scaling.freezingTreeLaw x n))
    Filter.atTop (nhds 0)
FreezingGrowth.Paper.theorem_1_3 : FreezingGrowth.FirstPairDeletionClaim
FreezingGrowth.Word.high_population_domination (xs : FreezingGrowth.Word) (ha : xs.admissible) {r : ℕ}
  (hhigh : ∃ j ≤ List.length xs, ↑r ≤ FreezingGrowth.activeCount xs.toSigns j) :
  FreezingGrowth.Word.HeightLE (List.replicate (r - 1) true) xs
FreezingGrowth.Paper.observation_2_1 {n : ℕ} (hn : 3 ≤ n) :
  ¬FreezingGrowth.Word.HeightLE (List.replicate n true) (FreezingGrowth.alternatingWord n)
FreezingGrowth.Paper.rrt_first_edge_split (n : ℕ) :
  MeasureTheory.Measure.map (FreezingGrowth.RRTSplit.firstEdgeSplit n)
      (FreezingGrowth.Forward.treeLaw FreezingGrowth.RRT.allAttach (n + 1)) =
    (MeasureTheory.Measure.uniformOfFinset (Finset.range (n + 1))).bind fun k =>
      MeasureTheory.Measure.map (fun p => (k, p.1, p.2))
        ((FreezingGrowth.Forward.treeLaw FreezingGrowth.RRT.allAttach k).prod
          (FreezingGrowth.Forward.treeLaw FreezingGrowth.RRT.allAttach (n - k)))
